{
  "name": "@ml-hub476/b-1003-ai-connection",
  "version": "0.1.0",
  "private": false,
  "description": "B-1003 AI Connection — sign in to Claude Pro/Max and ChatGPT Plus/Pro from Settings → Models, using each provider's own subscription sign-in instead of copying API keys.",
